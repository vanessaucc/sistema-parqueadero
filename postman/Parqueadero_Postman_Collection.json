                  "const j = pm.response.json();",
                  "pm.test('2 tiquetes en el historial', () => { pm.expect(j.totalTiquetesRealizados).to.eql(2); pm.expect(j.historialTiquetes.length).to.eql(2); });",
                  "pm.test('Gasto acumulado = suma de cobros', () => {",
                  "  const suma = j.historialTiquetes.reduce((a, t) => a + t.cobroFinal, 0);",
                  "  pm.expect(j.montoTotalGastado).to.eql(suma);",
                  "  pm.expect(j.montoTotalGastado).to.be.above(0);",
