{
  "info": {
    "name": "Parqueadero Spring Boot API",
    "description": "Colección completa del sistema ParqueaderoSpringBoot.\n\nEjecútala en orden (Runner o request por request): los IDs se guardan solos en variables de colección y las identificaciones/placas se generan únicas, por lo que puede re-ejecutarse sin errores de duplicado.\n\nRequiere la app corriendo en http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "conductorId",
      "value": "",
      "type": "string"
    },
    {
      "key": "identificacion",
      "value": "",
      "type": "string"
    },
    {
      "key": "placaAuto",
      "value": "",
      "type": "string"
    },
    {
      "key": "placaMoto",
      "value": "",
      "type": "string"
    },
    {
      "key": "vehiculoAutoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "vehiculoMotoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "tiqueteAutoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "tiqueteMotoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "incidenteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "fechaSalida",
      "value": "",
      "type": "string"
    },
    {
      "key": "fechaAhora",
      "value": "",
      "type": "string"
    },
    {
      "key": "ocupadasAutosAntes",
      "value": "0",
      "type": "string"
    },
    {
      "key": "ocupadasMotosAntes",
      "value": "0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Disponibilidad (estado inicial)",
      "item": [
        {
          "name": "1.1 Consultar disponibilidad en tiempo real",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/parqueadero/disponibilidad",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "parqueadero",
                "disponibilidad"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const d = pm.response.json();",
                  "pm.test('Incluye capacidad y espacios', () => {",
                  "  pm.expect(d).to.have.property('capacidadTotal');",
                  "  pm.expect(d).to.have.property('espaciosLibres');",
                  "  pm.expect(d.disponiblesAutomoviles).to.be.at.least(0);",
                  "  pm.expect(d.disponiblesMotocicletas).to.be.at.least(0);",
                  "});",
                  "pm.collectionVariables.set('ocupadasAutosAntes', d.ocupadasAutomoviles);",
                  "pm.collectionVariables.set('ocupadasMotosAntes', d.ocupadasMotocicletas);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Conductores",
      "item": [
        {
          "name": "2.1 Crear conductor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/conductores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conductores"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Maria Gonzalez\",\n  \"identificacion\": \"{{identificacion}}\",\n  \"telefono\": \"3112223344\",\n  \"email\": \"maria@parqueadero.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Genera una identificación única para poder re-ejecutar la colección sin choques (409)",
                  "const n = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set('identificacion', 'CC' + n);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('conductorId', j.id);",
                  "pm.test('Conductor activo y con ID', () => { pm.expect(j.id).to.be.a('string'); pm.expect(j.activo).to.eql(true); });",
                  "pm.test('Header Location apunta al recurso', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/conductores/'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Listar conductores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conductores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conductores"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Obtener conductor por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conductores/{{conductorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conductores",
                "{{conductorId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Mismo ID', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('conductorId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 PATCH - actualización parcial (nombre y email)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/conductores/{{conductorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conductores",
                "{{conductorId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Maria G. Torres\",\n  \"email\": \"maria_nueva@email.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Solo se modifican los campos presentes en el JSON; los omitidos (null) se conservan."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const j = pm.response.json();",
                  "pm.test('Campos enviados cambian', () => { pm.expect(j.nombre).to.eql('Maria G. Torres'); pm.expect(j.email).to.eql('maria_nueva@email.com'); });",
                  "pm.test('Teléfono no enviado se conserva', () => pm.expect(j.telefono).to.eql('3112223344'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 PATCH - intento de asignación masiva (identificacion / activo)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/conductores/{{conductorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conductores",
                "{{conductorId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"3000000000\",\n  \"identificacion\": \"HACKEADO\",\n  \"activo\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Demuestra la protección contra mass-assignment: el DTO de PATCH solo expone nombre, telefono y email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const j = pm.response.json();",
                  "pm.test('Teléfono sí se actualiza', () => pm.expect(j.telefono).to.eql('3000000000'));",
                  "pm.test('identificacion NO cambia', () => pm.expect(j.identificacion).to.eql(pm.collectionVariables.get('identificacion')));",
                  "pm.test('activo NO cambia', () => pm.expect(j.activo).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
