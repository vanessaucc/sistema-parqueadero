    {
      "name": "7. Salida y cobro",
      "item": [
        {
          "name": "7.1 Finalizar tiquete de la moto (fecha de salida +2h)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tiquetes/{{tiqueteMotoId}}/finalizar?fechaSalida={{fechaSalida}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tiquetes",
                "{{tiqueteMotoId}}",
                "finalizar"
              ],
              "query": [
                {
                  "key": "fechaSalida",
                  "value": "{{fechaSalida}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// fechaSalida en formato ISO local (sin zona), p.ej. 2026-10-06T15:30:00",
                  "const d = new Date(Date.now() + 2 * 3600 * 1000); const p = n => String(n).padStart(2, '0');",
                  "pm.collectionVariables.set('fechaSalida', d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+'T'+p(d.getHours())+':'+p(d.getMinutes())+':'+p(d.getSeconds()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const j = pm.response.json();",
                  "pm.test('FINALIZADO con cobro > 0', () => { pm.expect(j.estado).to.eql('FINALIZADO'); pm.expect(j.cobroFinal).to.be.above(0); });",
                  "pm.test('Cobro es múltiplo de la tarifa (2500/h)', () => pm.expect(j.cobroFinal % 2500).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "7.2 Finalizar tiquete del automóvil (hora actual)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tiquetes/{{tiqueteAutoId}}/finalizar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tiquetes",
                "{{tiqueteAutoId}}",
                "finalizar"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const j = pm.response.json();",
                  "pm.test('FINALIZADO, mínimo 1 hora cobrada', () => { pm.expect(j.estado).to.eql('FINALIZADO'); pm.expect(j.cobroFinal).to.be.at.least(5000); });"
                ]
              }
            }
          ]
        }
      ]
