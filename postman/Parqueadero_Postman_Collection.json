    {
      "name": "6. Incidentes",
      "item": [
        {
          "name": "6.1 Registrar incidente - RAYON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidentes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidentes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tiqueteId\": \"{{tiqueteAutoId}}\",\n  \"tipo\": \"RAYON\",\n  \"descripcion\": \"Rayón superficial en la puerta del conductor mientras salía otro vehículo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('incidenteId', j.id);",
                  "pm.test('Tipo y placa correctos', () => { pm.expect(j.tipo).to.eql('RAYON'); pm.expect(j.placaVehiculo).to.eql(pm.collectionVariables.get('placaAuto')); });",
                  "pm.test('Vinculado al tiquete', () => pm.expect(j.tiqueteId).to.eql(pm.collectionVariables.get('tiqueteAutoId')));",
                  "pm.test('Fecha/hora asignada automáticamente', () => pm.expect(j.fechaHora).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "6.2 Registrar incidente - CHOQUE (con fecha explícita)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidentes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidentes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tiqueteId\": \"{{tiqueteMotoId}}\",\n  \"tipo\": \"CHOQUE\",\n  \"descripcion\": \"Choque leve en la zona de motos\",\n  \"fechaHora\": \"{{fechaAhora}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); const p = n => String(n).padStart(2, '0');",
                  "pm.collectionVariables.set('fechaAhora', d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+'T'+p(d.getHours())+':'+p(d.getMinutes())+':'+p(d.getSeconds()));"
                ]
              }
            },
